{
  "batch_size": 2048,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 384,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 4,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 384,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adamax",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

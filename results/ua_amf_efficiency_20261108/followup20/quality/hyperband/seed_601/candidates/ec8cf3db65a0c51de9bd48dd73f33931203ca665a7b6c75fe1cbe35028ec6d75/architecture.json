{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

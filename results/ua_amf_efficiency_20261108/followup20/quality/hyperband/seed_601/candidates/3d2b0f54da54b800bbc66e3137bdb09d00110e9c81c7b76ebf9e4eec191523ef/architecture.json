{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 8,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

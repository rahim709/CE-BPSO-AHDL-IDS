{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 16,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

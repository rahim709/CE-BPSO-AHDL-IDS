{
  "batch_size": 512,
  "optimizer": "nesterov",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

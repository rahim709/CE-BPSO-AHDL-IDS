{
  "batch_size": 1024,
  "optimizer": "adam",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 8,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

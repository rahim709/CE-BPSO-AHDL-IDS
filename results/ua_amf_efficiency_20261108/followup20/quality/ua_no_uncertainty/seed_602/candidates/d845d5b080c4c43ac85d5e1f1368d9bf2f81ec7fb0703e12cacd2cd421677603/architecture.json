{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "rmsprop",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 5,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 2,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 8,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.0
    },
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "nesterov",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

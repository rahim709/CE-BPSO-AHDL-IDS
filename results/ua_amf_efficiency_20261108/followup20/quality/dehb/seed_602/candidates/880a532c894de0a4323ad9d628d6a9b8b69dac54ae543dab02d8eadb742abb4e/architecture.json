{
  "batch_size": 512,
  "optimizer": "adagrad",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 64,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "linear",
      "units": 512,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "adam",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

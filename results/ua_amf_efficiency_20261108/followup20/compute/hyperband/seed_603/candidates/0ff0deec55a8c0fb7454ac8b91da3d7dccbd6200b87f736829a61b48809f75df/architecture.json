{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 64,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

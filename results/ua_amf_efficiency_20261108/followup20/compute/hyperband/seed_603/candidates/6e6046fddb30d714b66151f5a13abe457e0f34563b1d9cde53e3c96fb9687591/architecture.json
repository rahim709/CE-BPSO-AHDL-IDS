{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adam",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

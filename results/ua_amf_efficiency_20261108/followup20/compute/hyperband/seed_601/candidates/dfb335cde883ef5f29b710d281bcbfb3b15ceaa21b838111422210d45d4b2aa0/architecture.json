{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.1
    }
  ]
}

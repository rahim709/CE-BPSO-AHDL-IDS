{
  "batch_size": 2048,
  "optimizer": "sgd",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

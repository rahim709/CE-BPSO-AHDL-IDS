{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

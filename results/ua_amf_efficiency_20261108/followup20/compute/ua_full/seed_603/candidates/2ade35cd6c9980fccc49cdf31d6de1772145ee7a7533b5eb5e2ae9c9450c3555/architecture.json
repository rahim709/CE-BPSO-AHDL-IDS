{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 4,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

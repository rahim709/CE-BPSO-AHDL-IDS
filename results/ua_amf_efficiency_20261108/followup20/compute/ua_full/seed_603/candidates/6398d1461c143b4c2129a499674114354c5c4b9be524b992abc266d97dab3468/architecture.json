{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 8,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

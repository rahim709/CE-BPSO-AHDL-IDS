{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 384,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

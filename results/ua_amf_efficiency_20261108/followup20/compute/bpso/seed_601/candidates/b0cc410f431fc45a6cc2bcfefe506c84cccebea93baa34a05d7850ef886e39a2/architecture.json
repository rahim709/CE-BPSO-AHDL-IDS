{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

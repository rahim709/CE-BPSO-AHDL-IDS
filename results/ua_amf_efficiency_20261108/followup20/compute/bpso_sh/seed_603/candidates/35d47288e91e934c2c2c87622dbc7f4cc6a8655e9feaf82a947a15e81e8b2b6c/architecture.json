{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "sgd",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 8,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

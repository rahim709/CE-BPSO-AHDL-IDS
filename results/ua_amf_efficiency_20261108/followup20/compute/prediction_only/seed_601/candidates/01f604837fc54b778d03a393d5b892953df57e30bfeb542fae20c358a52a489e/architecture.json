{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

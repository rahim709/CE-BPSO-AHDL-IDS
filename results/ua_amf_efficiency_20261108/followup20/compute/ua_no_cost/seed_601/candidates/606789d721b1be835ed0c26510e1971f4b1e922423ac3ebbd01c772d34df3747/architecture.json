{
  "batch_size": 2048,
  "optimizer": "sgd",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 512,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

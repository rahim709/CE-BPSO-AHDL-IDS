{
  "batch_size": 1024,
  "optimizer": "momentum",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.1
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

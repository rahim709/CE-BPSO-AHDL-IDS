{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

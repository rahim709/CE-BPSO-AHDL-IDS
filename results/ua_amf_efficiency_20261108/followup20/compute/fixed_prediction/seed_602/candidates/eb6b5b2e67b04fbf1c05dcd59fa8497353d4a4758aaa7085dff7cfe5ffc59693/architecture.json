{
  "batch_size": 512,
  "optimizer": "adadelta",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 384,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

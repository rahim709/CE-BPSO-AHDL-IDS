{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

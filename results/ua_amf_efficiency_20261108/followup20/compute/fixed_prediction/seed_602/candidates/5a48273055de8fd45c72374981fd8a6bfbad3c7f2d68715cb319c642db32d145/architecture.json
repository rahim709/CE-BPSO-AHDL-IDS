{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 384,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "linear",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

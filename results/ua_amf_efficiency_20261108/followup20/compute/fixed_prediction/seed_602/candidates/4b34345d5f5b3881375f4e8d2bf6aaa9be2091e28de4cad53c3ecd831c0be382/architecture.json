{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 512,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

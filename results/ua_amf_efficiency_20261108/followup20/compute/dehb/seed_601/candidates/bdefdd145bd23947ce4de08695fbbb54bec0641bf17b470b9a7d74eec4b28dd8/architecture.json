{
  "batch_size": 256,
  "optimizer": "adam",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

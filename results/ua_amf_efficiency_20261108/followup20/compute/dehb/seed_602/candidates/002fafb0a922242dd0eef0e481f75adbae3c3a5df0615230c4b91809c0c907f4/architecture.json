{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 32,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "nesterov",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

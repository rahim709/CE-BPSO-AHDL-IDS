{
  "batch_size": 256,
  "optimizer": "nesterov",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.2
    },
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

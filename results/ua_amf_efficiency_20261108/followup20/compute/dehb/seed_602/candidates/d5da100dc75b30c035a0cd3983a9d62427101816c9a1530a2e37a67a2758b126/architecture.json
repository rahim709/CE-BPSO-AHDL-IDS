{
  "batch_size": 2048,
  "optimizer": "nesterov",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 8,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

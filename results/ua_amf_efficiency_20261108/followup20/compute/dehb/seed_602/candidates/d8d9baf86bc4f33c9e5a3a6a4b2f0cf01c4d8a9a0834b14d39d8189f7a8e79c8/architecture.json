{
  "batch_size": 512,
  "optimizer": "rmsprop",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 4,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 3,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 32,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

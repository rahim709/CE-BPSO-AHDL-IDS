{
  "batch_size": 2048,
  "optimizer": "sgd",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

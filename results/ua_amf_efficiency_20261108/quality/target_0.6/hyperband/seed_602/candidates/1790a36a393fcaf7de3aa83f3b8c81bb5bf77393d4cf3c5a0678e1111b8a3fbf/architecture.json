{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

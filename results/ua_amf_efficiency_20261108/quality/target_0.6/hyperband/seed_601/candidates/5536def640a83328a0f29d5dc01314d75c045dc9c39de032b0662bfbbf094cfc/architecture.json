{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 16,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 128,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

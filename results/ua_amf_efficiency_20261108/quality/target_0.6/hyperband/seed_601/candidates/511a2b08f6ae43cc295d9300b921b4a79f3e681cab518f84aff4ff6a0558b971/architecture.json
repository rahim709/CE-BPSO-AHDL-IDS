{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "linear",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

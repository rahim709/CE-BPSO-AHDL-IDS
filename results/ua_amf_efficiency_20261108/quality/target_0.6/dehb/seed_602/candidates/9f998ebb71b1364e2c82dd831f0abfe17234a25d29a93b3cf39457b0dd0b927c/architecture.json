{
  "batch_size": 512,
  "optimizer": "nesterov",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 384,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

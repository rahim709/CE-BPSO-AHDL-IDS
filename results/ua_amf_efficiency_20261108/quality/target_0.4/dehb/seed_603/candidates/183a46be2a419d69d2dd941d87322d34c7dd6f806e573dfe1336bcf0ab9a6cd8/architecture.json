{
  "batch_size": 2048,
  "optimizer": "sgd",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.1
    },
    {
      "kind": "lstm",
      "units": 8,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

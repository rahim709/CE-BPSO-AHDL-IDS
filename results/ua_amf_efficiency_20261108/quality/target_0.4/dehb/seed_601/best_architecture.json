{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

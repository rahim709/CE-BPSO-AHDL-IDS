{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 384,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 2,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 8,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

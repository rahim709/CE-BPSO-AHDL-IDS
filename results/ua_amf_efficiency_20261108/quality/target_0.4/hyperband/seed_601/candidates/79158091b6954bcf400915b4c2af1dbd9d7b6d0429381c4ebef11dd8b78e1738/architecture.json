{
  "batch_size": 2048,
  "optimizer": "adadelta",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 384,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 384,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

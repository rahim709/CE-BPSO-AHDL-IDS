{
  "batch_size": 2048,
  "optimizer": "adagrad",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 128,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

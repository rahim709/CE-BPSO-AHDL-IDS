{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 384,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

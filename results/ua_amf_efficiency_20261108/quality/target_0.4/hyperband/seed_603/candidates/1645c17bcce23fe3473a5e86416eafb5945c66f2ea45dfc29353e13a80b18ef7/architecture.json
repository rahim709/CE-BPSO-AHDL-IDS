{
  "batch_size": 512,
  "optimizer": "adadelta",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 3,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 128,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

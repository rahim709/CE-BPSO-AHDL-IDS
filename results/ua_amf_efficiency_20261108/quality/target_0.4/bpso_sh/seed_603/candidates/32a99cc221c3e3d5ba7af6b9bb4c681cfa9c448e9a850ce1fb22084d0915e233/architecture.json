{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.1
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "sgd",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

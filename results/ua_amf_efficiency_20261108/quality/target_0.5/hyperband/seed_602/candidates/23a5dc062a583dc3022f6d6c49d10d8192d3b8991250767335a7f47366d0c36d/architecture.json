{
  "batch_size": 1024,
  "optimizer": "adamax",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 128,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.0
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

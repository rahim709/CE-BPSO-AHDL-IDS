{
  "batch_size": 512,
  "optimizer": "rmsprop",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

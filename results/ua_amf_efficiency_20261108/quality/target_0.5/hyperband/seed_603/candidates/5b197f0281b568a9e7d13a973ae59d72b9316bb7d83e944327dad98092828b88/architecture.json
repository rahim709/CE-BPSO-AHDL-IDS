{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.1
    },
    {
      "kind": "linear",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "nesterov",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.1
    },
    {
      "kind": "linear",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "momentum",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 2,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

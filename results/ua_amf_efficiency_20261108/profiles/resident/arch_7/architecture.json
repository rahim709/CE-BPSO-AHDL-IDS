{
  "batch_size": 512,
  "optimizer": "sgd",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 8,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

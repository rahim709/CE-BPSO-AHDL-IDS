{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

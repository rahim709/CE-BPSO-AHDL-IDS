{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

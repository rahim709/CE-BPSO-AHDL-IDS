{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

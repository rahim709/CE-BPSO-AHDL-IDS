{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "adam",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 64,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

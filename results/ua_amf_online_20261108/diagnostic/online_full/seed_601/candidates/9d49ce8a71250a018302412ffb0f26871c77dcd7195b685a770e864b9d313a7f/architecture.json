{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

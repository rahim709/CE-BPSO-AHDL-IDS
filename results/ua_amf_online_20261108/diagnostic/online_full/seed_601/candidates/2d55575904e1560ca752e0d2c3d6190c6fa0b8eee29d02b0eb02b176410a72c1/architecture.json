{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 4,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

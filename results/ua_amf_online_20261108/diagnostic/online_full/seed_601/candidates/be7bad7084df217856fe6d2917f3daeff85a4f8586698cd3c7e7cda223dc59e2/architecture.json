{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

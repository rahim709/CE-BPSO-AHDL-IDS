{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

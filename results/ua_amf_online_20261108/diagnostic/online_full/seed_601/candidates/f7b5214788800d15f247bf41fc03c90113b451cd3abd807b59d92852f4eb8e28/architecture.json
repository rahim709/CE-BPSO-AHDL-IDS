{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

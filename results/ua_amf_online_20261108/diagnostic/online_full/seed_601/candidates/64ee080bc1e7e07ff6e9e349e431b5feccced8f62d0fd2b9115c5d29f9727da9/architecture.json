{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

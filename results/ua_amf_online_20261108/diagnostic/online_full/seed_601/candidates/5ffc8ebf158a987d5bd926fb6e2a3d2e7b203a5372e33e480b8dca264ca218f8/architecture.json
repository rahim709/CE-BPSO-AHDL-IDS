{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,

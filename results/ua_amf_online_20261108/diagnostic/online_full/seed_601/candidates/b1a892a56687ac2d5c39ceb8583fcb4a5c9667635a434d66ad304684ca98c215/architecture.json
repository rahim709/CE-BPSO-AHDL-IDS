{
  "batch_size": 256,
  "optimizer": "adam",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 4,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]

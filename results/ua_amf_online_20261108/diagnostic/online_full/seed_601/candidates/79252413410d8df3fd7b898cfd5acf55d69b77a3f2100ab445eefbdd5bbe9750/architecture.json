{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

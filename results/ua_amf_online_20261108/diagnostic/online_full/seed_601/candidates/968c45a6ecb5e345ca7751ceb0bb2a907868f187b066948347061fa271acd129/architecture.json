{
  "batch_size": 512,
  "optimizer": "adadelta",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

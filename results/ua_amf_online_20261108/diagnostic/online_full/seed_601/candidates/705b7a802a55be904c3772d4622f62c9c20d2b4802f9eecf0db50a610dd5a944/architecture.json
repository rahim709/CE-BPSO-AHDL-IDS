{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "linear",
      "units": 16,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

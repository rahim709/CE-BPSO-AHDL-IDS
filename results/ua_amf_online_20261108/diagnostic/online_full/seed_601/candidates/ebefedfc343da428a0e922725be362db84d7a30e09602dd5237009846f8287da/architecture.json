{
  "batch_size": 512,
  "optimizer": "sgd",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

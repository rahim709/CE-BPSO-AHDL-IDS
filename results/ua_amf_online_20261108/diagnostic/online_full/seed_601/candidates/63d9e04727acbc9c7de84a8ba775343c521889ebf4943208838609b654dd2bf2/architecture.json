{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    }

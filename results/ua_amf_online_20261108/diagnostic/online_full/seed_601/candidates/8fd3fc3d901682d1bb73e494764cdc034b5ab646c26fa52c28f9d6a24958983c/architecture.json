{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

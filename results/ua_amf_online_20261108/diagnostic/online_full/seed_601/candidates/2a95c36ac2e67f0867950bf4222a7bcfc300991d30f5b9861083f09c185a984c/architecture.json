{
  "batch_size": 256,
  "optimizer": "adam",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

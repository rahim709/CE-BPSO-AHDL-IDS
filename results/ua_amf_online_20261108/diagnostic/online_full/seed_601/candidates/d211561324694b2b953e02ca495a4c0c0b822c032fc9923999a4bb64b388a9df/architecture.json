{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

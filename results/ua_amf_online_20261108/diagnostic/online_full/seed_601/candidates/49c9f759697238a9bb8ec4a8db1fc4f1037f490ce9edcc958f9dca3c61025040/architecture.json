{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

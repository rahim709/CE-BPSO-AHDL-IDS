{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

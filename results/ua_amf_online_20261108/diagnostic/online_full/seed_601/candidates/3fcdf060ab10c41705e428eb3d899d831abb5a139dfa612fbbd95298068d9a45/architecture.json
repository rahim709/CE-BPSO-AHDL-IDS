{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

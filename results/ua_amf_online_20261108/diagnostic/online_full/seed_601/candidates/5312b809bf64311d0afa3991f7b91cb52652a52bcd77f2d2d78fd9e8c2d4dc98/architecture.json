{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

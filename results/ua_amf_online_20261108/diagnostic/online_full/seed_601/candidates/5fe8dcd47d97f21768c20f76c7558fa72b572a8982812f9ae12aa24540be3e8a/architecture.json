{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    }

{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

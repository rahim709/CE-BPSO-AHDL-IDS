{
  "batch_size": 512,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

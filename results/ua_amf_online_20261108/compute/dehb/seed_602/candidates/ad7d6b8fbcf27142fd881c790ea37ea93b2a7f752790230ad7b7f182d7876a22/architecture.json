{
  "batch_size": 512,
  "optimizer": "nesterov",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 4,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 128,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

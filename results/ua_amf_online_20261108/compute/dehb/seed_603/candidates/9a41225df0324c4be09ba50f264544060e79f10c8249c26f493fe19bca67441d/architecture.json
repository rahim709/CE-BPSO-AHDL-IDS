{
  "batch_size": 2048,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 16,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "linear",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "momentum",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

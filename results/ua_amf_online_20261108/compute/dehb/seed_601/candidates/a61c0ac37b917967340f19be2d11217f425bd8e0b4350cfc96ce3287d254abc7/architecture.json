{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

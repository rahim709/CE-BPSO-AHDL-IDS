{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 512,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

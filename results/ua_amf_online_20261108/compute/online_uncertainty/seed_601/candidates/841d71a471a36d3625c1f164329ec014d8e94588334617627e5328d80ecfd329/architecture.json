{
  "batch_size": 256,
  "optimizer": "adam",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

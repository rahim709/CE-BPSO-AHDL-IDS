{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "linear",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

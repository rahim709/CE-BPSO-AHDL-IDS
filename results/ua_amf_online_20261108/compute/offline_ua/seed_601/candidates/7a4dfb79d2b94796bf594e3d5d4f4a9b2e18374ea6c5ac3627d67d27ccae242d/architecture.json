{
  "batch_size": 2048,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

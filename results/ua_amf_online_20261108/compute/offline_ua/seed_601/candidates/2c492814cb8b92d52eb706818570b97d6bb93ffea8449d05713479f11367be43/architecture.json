{
  "batch_size": 256,
  "optimizer": "adamax",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

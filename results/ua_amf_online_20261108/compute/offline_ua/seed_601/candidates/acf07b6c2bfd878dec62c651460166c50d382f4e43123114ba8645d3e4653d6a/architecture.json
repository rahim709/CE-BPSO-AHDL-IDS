{
  "batch_size": 1024,
  "optimizer": "adamax",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 128,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

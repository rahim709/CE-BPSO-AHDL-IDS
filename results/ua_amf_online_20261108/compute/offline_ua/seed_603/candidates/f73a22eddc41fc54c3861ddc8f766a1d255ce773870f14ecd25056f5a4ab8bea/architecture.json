{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 128,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

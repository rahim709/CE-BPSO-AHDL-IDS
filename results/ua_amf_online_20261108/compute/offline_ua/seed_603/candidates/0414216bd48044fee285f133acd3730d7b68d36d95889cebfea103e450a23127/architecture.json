{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 384,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

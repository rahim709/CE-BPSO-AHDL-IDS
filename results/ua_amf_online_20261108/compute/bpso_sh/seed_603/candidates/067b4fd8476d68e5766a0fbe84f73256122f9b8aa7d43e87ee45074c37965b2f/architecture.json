{
  "batch_size": 1024,
  "optimizer": "momentum",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 384,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

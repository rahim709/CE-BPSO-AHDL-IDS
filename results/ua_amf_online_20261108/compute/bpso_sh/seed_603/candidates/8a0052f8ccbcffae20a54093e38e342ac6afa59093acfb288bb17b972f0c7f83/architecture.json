{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

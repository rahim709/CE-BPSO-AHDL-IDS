{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 32,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "sgd",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 4,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "linear",
      "units": 128,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

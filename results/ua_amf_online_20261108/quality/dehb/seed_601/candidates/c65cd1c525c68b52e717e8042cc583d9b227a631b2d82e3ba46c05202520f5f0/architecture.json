{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

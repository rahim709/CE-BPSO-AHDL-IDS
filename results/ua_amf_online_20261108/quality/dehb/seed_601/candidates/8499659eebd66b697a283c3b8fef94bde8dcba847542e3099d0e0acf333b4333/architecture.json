{
  "batch_size": 2048,
  "optimizer": "momentum",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

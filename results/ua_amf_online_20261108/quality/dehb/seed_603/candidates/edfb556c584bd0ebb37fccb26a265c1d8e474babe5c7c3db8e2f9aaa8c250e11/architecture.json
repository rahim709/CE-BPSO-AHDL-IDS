{
  "batch_size": 2048,
  "optimizer": "rmsprop",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 128,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

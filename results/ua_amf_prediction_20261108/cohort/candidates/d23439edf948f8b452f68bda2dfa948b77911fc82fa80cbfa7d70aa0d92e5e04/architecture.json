{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 2048,
  "optimizer": "rmsprop",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

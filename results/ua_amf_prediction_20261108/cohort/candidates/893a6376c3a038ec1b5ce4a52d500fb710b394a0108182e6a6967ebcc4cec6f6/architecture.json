{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "linear",
      "units": 128,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

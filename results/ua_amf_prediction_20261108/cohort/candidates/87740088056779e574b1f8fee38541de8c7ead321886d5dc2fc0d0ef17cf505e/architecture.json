{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 2,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

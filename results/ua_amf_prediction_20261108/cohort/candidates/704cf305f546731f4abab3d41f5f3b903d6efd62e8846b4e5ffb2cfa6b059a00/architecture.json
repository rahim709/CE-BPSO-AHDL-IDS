{
  "batch_size": 512,
  "optimizer": "sgd",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 32,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

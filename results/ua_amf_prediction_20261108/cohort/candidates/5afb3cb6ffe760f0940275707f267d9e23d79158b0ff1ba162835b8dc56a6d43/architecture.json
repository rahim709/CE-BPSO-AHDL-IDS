{
  "batch_size": 1024,
  "optimizer": "adamax",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 4,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 128,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

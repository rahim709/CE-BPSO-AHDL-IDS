{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 4,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 5,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

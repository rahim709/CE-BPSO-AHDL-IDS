{
  "batch_size": 1024,
  "optimizer": "adam",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.1
    }
  ]
}

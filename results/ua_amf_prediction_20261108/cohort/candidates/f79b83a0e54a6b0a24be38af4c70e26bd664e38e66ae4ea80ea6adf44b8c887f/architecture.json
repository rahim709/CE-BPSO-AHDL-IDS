{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 8,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

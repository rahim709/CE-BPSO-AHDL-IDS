{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 384,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 64,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

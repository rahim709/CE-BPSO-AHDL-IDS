{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 3,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "linear",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

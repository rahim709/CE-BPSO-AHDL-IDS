{
  "batch_size": 2048,
  "optimizer": "adadelta",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "linear",
      "units": 128,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

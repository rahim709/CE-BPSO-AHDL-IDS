{
  "batch_size": 2048,
  "optimizer": "nesterov",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 2,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 64,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

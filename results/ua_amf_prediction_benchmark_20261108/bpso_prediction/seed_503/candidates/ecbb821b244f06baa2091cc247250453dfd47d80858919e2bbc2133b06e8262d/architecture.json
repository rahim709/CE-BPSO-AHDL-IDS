{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 384,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 64,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "linear",
      "units": 8,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "adadelta",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

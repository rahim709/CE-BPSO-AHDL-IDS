{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 384,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

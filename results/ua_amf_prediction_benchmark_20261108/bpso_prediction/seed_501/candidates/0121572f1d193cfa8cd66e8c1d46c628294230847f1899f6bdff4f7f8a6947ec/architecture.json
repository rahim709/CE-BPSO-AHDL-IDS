{
  "batch_size": 256,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 32,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

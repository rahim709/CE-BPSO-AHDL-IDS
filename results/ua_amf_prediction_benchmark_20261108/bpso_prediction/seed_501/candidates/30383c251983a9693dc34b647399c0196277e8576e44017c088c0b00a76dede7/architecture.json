{
  "batch_size": 512,
  "optimizer": "nesterov",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 128,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "adam",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

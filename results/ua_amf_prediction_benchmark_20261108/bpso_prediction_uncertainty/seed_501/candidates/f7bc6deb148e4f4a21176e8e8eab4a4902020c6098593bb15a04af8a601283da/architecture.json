{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 64,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

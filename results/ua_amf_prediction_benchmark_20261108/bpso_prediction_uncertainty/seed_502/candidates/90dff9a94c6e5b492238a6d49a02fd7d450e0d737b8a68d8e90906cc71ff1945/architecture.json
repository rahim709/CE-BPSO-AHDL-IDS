{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 128,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.3
    }
  ]

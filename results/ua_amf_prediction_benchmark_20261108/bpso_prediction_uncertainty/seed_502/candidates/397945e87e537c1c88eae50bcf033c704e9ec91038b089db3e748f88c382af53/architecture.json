{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 128,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

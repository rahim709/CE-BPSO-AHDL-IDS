{
  "batch_size": 256,
  "optimizer": "momentum",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

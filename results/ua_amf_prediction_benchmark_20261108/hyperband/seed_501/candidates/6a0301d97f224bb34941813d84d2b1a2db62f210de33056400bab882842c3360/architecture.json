{
  "batch_size": 256,
  "optimizer": "adam",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

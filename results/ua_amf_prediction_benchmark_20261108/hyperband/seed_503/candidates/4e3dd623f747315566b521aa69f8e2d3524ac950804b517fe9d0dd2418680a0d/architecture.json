{
  "batch_size": 1024,
  "optimizer": "adagrad",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

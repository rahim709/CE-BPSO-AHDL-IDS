{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

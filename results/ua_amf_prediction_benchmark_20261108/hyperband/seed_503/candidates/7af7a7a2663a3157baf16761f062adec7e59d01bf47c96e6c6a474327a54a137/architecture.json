{
  "batch_size": 256,
  "optimizer": "adamax",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "sgd",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

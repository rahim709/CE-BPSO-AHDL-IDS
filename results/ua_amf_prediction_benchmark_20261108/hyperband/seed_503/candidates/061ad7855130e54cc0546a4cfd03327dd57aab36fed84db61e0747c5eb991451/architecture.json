{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 128,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

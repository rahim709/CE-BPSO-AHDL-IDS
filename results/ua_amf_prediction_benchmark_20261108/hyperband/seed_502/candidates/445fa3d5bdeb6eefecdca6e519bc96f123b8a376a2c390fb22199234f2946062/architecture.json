{
  "batch_size": 256,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 32,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.3
    }
  ]
}

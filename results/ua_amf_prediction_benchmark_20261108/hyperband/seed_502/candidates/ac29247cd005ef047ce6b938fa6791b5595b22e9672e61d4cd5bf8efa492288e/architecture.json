{
  "batch_size": 1024,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 1,
      "activation": "tanh"

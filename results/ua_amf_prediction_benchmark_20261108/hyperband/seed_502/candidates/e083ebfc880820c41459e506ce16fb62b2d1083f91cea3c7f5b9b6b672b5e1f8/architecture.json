{
  "batch_size": 2048,
  "optimizer": "rmsprop",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 384,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

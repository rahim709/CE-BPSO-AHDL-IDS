{
  "batch_size": 512,
  "optimizer": "rmsprop",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 384,
      "kernel": 3,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 5,
      "pool": 4,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

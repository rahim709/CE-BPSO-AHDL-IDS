{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 5,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "linear",
      "units": 64,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

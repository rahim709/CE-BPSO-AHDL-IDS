{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 2,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 4,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.1
    },
    {
      "kind": "lstm",
      "units": 384,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

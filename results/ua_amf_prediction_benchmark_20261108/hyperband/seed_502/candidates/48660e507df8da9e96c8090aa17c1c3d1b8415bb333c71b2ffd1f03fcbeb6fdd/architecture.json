{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 2,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

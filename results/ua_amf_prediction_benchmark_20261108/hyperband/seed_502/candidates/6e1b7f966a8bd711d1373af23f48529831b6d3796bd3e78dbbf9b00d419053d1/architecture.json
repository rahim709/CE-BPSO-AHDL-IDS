{
  "batch_size": 512,
  "optimizer": "adadelta",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 32,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

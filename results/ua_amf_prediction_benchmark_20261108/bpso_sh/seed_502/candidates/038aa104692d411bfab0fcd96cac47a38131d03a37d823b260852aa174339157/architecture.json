{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

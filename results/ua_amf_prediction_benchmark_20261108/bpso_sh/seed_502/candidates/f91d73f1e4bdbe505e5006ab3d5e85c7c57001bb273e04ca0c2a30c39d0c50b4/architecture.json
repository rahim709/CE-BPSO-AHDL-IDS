{
  "batch_size": 2048,
  "optimizer": "adagrad",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

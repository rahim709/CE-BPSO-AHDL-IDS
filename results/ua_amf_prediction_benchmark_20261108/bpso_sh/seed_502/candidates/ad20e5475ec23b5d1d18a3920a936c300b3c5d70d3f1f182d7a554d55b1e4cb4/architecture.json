{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.1
    },
    {
      "kind": "linear",
      "units": 32,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

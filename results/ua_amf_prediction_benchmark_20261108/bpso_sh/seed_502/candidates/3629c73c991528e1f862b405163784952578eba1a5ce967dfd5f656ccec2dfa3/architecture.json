{
  "batch_size": 2048,
  "optimizer": "adadelta",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 64,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

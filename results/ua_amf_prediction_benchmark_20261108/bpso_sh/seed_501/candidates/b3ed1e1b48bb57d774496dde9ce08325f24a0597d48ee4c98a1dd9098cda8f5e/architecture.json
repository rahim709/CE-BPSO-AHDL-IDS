{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 3,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 16,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

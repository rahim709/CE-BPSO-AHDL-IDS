{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 512,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

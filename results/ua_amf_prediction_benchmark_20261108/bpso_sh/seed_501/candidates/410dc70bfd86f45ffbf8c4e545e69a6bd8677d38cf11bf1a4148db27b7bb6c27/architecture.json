{
  "batch_size": 256,
  "optimizer": "nesterov",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "lstm",
      "units": 16,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

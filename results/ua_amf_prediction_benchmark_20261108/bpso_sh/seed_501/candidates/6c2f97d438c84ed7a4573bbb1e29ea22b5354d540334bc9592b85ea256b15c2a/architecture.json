{
  "batch_size": 256,
  "optimizer": "sgd",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 64,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 5,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 256,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

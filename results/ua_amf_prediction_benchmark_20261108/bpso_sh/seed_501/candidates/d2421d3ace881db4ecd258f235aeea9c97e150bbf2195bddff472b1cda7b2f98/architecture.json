{
  "batch_size": 256,
  "optimizer": "nesterov",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 32,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

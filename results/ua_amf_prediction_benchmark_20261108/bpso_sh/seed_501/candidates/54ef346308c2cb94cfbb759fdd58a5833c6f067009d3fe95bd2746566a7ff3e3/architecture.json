{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 8,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

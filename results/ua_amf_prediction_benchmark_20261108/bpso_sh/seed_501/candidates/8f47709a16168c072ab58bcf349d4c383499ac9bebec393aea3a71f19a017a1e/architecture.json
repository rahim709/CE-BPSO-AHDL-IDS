{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.2
    },
    {
      "kind": "lstm",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 64,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "linear",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 3,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    }

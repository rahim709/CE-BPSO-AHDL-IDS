{
  "batch_size": 256,
  "optimizer": "adadelta",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 16,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 2,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 2,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.1
    },
    {
      "kind": "lstm",
      "units": 512,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

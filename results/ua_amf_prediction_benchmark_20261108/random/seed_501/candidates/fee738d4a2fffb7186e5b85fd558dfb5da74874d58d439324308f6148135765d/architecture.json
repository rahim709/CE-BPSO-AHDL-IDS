{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 32,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

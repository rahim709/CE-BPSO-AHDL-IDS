{
  "batch_size": 2048,
  "optimizer": "adagrad",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 3,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.1
    }
  ]
}

{
  "batch_size": 512,
  "optimizer": "nesterov",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

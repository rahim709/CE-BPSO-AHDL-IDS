{
  "batch_size": 2048,
  "optimizer": "adadelta",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 1,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 8,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 64,
      "activation": "relu",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

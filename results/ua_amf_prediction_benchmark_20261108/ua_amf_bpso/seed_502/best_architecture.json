{
  "batch_size": 1024,
  "optimizer": "adamax",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.2
    }
  ]
}

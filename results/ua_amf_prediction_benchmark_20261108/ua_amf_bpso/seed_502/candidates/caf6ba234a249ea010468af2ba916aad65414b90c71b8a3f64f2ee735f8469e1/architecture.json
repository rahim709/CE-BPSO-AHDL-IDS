{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 5,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,

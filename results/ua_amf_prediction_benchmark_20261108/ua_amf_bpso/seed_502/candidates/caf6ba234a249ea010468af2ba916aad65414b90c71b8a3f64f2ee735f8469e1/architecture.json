    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 1,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 2,
      "pool": 4,
      "activation": "none"
    }

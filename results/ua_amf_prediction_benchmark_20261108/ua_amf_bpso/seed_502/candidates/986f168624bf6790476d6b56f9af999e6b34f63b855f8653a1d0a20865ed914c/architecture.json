{
  "batch_size": 1024,
  "optimizer": "momentum",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 3,
      "pool": 2,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 384,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

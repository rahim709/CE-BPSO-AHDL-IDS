{
  "batch_size": 1024,
  "optimizer": "momentum",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 3,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 16,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.0
    },
    {
      "kind": "gru",
      "units": 512,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "adagrad",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 16,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "relu",
      "regularization": "none",
      "dropout": 0.1
    }
  ]
}

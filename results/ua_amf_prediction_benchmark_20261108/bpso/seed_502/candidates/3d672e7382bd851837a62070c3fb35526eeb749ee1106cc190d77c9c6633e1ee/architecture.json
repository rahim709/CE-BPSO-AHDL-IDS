{
  "batch_size": 512,
  "optimizer": "adam",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 128,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

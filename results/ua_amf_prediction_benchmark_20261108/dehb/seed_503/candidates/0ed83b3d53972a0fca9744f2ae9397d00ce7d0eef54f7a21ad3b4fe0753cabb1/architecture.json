{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 4,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 8,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

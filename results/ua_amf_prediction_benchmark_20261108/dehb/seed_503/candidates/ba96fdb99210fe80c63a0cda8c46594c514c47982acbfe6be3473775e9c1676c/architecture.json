{
  "batch_size": 512,
  "optimizer": "rmsprop",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 384,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

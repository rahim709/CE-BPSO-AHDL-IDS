{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 3,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.2
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.3
    }
  ]
}

{
  "batch_size": 256,
  "optimizer": "nesterov",
  "learning_rate": 0.0001,
  "cnn": [
    {
      "padding": "same",
      "filters": 256,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "none",
      "regularization": "l1",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 256,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

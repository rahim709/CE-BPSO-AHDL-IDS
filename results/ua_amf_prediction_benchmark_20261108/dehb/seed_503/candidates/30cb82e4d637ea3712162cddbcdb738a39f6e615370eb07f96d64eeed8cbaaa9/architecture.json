{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 5,
      "pool": 2,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 512,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 128,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

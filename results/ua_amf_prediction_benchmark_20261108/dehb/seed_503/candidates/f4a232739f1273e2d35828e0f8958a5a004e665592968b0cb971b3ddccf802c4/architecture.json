{
  "batch_size": 512,
  "optimizer": "momentum",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 512,
      "kernel": 4,
      "pool": 3,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 4,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 256,
      "activation": "none",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "gru",
      "units": 16,
      "activation": "relu",
      "regularization": "l1_l2",
      "dropout": 0.0
    }
  ]
}

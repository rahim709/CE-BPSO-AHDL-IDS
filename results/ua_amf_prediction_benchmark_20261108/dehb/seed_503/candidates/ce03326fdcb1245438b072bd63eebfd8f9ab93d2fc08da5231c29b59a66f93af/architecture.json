{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}

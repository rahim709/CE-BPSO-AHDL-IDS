{
  "batch_size": 2048,
  "optimizer": "adamax",
  "learning_rate": 0.001,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 2,
      "pool": 1,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

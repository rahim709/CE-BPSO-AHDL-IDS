{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 16,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 64,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

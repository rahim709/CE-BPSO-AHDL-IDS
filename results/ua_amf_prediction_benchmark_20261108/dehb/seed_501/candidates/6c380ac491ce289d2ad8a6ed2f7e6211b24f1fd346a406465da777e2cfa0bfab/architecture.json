{
  "batch_size": 256,
  "optimizer": "adamax",
  "learning_rate": 0.005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 3,
      "pool": 4,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 2,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 8,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.3
    }
  ]
}

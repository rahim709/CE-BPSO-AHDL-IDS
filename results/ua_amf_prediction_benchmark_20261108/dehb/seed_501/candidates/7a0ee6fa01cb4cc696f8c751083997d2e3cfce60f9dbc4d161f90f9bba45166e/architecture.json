{
  "batch_size": 1024,
  "optimizer": "adadelta",
  "learning_rate": 0.01,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 2,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "l1_l2",
      "dropout": 0.3
    },
    {
      "kind": "simrnn",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

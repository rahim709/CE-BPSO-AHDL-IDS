{
  "batch_size": 512,
  "optimizer": "rmsprop",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 512,
      "kernel": 4,
      "pool": 1,
      "activation": "sigmoid"
    },
    {
      "padding": "same",
      "filters": 64,
      "kernel": 5,
      "pool": 1,
      "activation": "none"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 32,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    }
  ]
}

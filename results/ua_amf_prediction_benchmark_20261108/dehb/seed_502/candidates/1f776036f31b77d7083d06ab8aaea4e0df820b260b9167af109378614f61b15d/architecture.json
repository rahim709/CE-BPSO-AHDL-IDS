{
  "batch_size": 256,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 2,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 3,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 5,
      "pool": 1,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 128,
      "activation": "sigmoid",
      "regularization": "none",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 384,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 1e-05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 384,
      "kernel": 4,
      "pool": 3,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 64,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.1
    },
    {
      "kind": "lstm",
      "units": 128,
      "activation": "tanh",
      "regularization": "l1",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 3,
      "activation": "sigmoid"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 16,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.1
    }
  ]
}

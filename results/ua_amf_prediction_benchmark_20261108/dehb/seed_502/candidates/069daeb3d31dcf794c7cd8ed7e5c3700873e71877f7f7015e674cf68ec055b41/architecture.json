{
  "batch_size": 256,
  "optimizer": "rmsprop",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "same",
      "filters": 8,
      "kernel": 3,
      "pool": 2,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "gru",
      "units": 256,
      "activation": "none",
      "regularization": "l1_l2",
      "dropout": 0.1
    },
    {
      "kind": "simrnn",
      "units": 16,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.3
    }
  ]
}

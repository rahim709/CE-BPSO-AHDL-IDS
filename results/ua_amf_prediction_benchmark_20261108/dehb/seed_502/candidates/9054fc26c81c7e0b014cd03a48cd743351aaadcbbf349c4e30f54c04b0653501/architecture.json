{
  "batch_size": 1024,
  "optimizer": "sgd",
  "learning_rate": 5e-05,
  "cnn": [
    {
      "padding": "same",
      "filters": 128,
      "kernel": 3,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "same",
      "filters": 128,
      "kernel": 5,
      "pool": 4,
      "activation": "none"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    }
  ],
  "rnn": [
    {
      "kind": "linear",
      "units": 256,
      "activation": "none",
      "regularization": "l2",
      "dropout": 0.3
    },
    {
      "kind": "lstm",
      "units": 32,
      "activation": "tanh",
      "regularization": "none",
      "dropout": 0.0
    }
  ]
}

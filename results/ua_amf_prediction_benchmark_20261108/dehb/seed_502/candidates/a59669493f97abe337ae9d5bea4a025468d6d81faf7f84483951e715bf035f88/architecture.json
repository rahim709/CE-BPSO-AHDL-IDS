{
  "batch_size": 512,
  "optimizer": "adamax",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 2,
      "pool": 4,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 3,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 256,
      "kernel": 5,
      "pool": 4,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 32,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "lstm",
      "units": 64,
      "activation": "relu",
      "regularization": "l1",
      "dropout": 0.0
    },
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "sigmoid",
      "regularization": "l1",
      "dropout": 0.1
    }
  ]
}

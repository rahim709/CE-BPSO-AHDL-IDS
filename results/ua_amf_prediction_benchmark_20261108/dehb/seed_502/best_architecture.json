{
  "batch_size": 1024,
  "optimizer": "rmsprop",
  "learning_rate": 0.0005,
  "cnn": [
    {
      "padding": "valid",
      "filters": 16,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    },
    {
      "padding": "same",
      "filters": 256,
      "kernel": 4,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "sigmoid"
    },
    {
      "padding": "valid",
      "filters": 128,
      "kernel": 2,
      "pool": 3,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 512,
      "activation": "tanh",
      "regularization": "l2",
      "dropout": 0.1
    },
    {
      "kind": "lstm",
      "units": 16,
      "activation": "tanh",
      "regularization": "l1_l2",
      "dropout": 0.2
    }
  ]
}

{
  "batch_size": 1024,
  "optimizer": "nesterov",
  "learning_rate": 0.05,
  "cnn": [
    {
      "padding": "valid",
      "filters": 32,
      "kernel": 3,
      "pool": 1,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 64,
      "kernel": 5,
      "pool": 3,
      "activation": "relu"
    },
    {
      "padding": "valid",
      "filters": 384,
      "kernel": 4,
      "pool": 2,
      "activation": "tanh"
    }
  ],
  "rnn": [
    {
      "kind": "simrnn",
      "units": 8,
      "activation": "sigmoid",
      "regularization": "l2",
      "dropout": 0.0
    }
  ]
}
